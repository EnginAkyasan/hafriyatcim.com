# ─── hafriyatcim.com backend ortam değişkenleri ───────────────────────────────
# Bu dosyayı backend/.env olarak kopyalayın. .env asla git'e eklenmez.

NODE_ENV=development
PORT=5050
FRONTEND_URL=http://localhost:5050

# Zorunlu: en az 32 karakter, birbirinden farklı rastgele değerler
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
REFRESH_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# Admin hesabı (ilk açılışta yoksa oluşturulur; en az 12 karakter şifre)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Yönetici

# Supabase (Google ile giriş köprüsü için; yoksa Supabase girişi 503 döner)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google ID token girişi (eski akış, opsiyonel)
GOOGLE_CLIENT_ID=

# iyzico (production'da zorunlu; sandbox anahtarları https://sandbox-merchant.iyzipay.com)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Platform ücreti (varsayılan 200 ₺ net, %26 KDV → 252 ₺)
PLATFORM_FEE_NET=200
PLATFORM_KDV_ORANI=26

# NetGSM SMS (boşsa SMS'ler yalnızca loglanır)
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_HEADER=HAFRIYAT
